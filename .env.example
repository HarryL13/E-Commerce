# Changes:
# - All AI calls use GEMINI_DIRECT_API_KEY (direct Google API).
# - Local dev: copy to .dev.vars (gitignored). Production: Cloudflare Pages env vars.
#
# All values are SERVER-SIDE ONLY — consumed by /functions/api, never shipped to browser.

# --- Required: personal Google Gemini key ---
# Get one at https://aistudio.google.com/apikey
# Used for: SKU copy, image analyze, and all Image Studio generation.
GEMINI_DIRECT_API_KEY=AIza_your_personal_google_gemini_key

# --- App access password ---
APP_PASSWORD=change-me-please

# --- Optional: OpenAI image models (gpt-image-2) only ---
# OPENAI_API_KEY=sk-your_personal_openai_key

# --- Legacy company proxy (no longer used by default) ---
# API_BASE_URL=http://120.48.38.233:4000
# API_AUTH_TOKEN=your_company_proxy_bearer_token
