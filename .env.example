# Changes:
# - Gemini-only setup: GEMINI_DIRECT_API_KEY + APP_PASSWORD.
# - Shopify publish: SHOPIFY_ACCESS_TOKEN + SHOPIFY_STORE_NAME.
# - Local dev: copy to .dev.vars (gitignored). Production: Cloudflare Pages env vars.

# Required — personal Google Gemini key (https://aistudio.google.com/apikey)
GEMINI_DIRECT_API_KEY=AIza_your_personal_google_gemini_key

# Required — site login password
APP_PASSWORD=change-me-please

# Required for Publish to Shopify (same as ~/Desktop/shopify-mcp-app/.env)
SHOPIFY_ACCESS_TOKEN=shpat_your_admin_api_token
SHOPIFY_STORE_NAME=exn11x-id
