# Changes: Primary config is company CometAPI (API_BASE_URL + API_AUTH_TOKEN).
# Local: copy to .dev.vars (gitignored). Production: Cloudflare Pages env vars.

# Required — company CometAPI (OpenAI-compatible gateway)
API_BASE_URL=https://api.cometapi.com
API_AUTH_TOKEN=sk-your_company_cometapi_key

# Required — site login password
APP_PASSWORD=change-me-please

# Required for Publish to Shopify
SHOPIFY_ACCESS_TOKEN=shpat_your_admin_api_token
SHOPIFY_STORE_NAME=exn11x-id

# Optional — personal Google Gemini key (fallback only; leave unset to use CometAPI only)
# GEMINI_DIRECT_API_KEY=AIza_your_personal_google_gemini_key
