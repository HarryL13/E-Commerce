# Changes:
# - LiteLLM proxy URL: http://120.48.38.233:4000
# - Local dev: copy to .dev.vars (gitignored). Production: Cloudflare Pages env vars.
#
# All values are SERVER-SIDE ONLY — consumed by /functions/api, never shipped to browser.

# --- Company LiteLLM proxy (recommended) ---
# One gateway for Gemini, OpenAI image, and text models.
API_BASE_URL=http://120.48.38.233:4000
API_AUTH_TOKEN=your_company_proxy_bearer_token

# Legacy aliases — set to the SAME values when using the company proxy:
ANTHROPIC_BASE_URL=http://120.48.38.233:4000
ANTHROPIC_AUTH_TOKEN=your_company_proxy_bearer_token
ANTHROPIC_API_KEY=your_company_proxy_bearer_token
GEMINI_API_KEY=your_company_proxy_bearer_token
OPENAI_API_KEY=your_company_proxy_bearer_token

# Optional: override proxy chat models if gateway model list changes
# PROXY_TEXT_MODEL=qwen3.6-flash
# PROXY_VISION_MODEL=qwen3-vl-flash

# --- App access password ---
APP_PASSWORD=change-me-please
